PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/brightloop
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Resend Email API for OTP verification
RESEND_API_KEY=
RESEND_FROM=Brightloop <onboarding@resend.dev>

# Password-reset email via SMTP (optional).
# In local development when not configured, devResetUrl and devOtp are returned in the response.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Brightloop <noreply@brightloop.com>
